# VMD script for HOP label trajectory
# Usage: vmd -e view_hop.vmd

mol new ../06_labels/hydrate_labels.pdb type pdb waitfor all
mol delrep 0 top
display projection Orthographic
axes location Off
color Display Background white

# 0: liquid
mol representation VDW 0.450 12.000
mol color ColorID 0
mol selection "beta == 0.0"
mol material Opaque
mol addrep top

# 1: ice_Ih
mol representation VDW 0.450 12.000
mol color ColorID 10
mol selection "beta == 1.0"
mol material Opaque
mol addrep top

# 2: ice_Ic
mol representation VDW 0.450 12.000
mol color ColorID 15
mol selection "beta == 2.0"
mol material Opaque
mol addrep top

# 3: hydrate_crystal_like
mol representation VDW 0.450 12.000
mol color ColorID 1
mol selection "beta == 3.0"
mol material Opaque
mol addrep top

# 4: hydrate_precursor_or_amorphous_hydrate
mol representation VDW 0.450 12.000
mol color ColorID 3
mol selection "beta == 4.0"
mol material Opaque
mol addrep top

# 5: interface_or_uncertain
mol representation VDW 0.450 12.000
mol color ColorID 2
mol selection "beta == 5.0"
mol material Opaque
mol addrep top

animate goto 0
puts "HOP labels are stored in beta factor."
puts "Label definition:"
puts "  beta 0: liquid"
puts "  beta 1: ice_Ih"
puts "  beta 2: ice_Ic"
puts "  beta 3: hydrate_crystal_like"
puts "  beta 4: hydrate_precursor_or_amorphous_hydrate"
puts "  beta 5: interface_or_uncertain"
