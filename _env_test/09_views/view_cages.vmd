# VMD script for cage PDB files
# Usage: vmd -e view_cages.vmd

display projection Orthographic
axes location Off
color Display Background white

set cage_files [lsort [glob -nocomplain ../07_cages_pdb/cages_frame_*.pdb]]
if {[llength $cage_files] == 0} {
    puts "No cage PDB files found."
    return
}

foreach pdb $cage_files {
    mol new $pdb type pdb waitfor all
    mol delrep 0 top
    mol representation Licorice 0.200 12.000 12.000
    mol color Name
    mol selection all
    mol material Opaque
    mol addrep top
}

puts "Cage type encoding uses atom name, resname, element, and beta factor."
puts "Cage beta definition:"
puts "  5^12                 beta=  1.0 resname=SML color=red"
puts "  5^12_6^2             beta=  2.0 resname=LR1 color=orange"
puts "  5^12_6^4             beta=  3.0 resname=LR2 color=green"
puts "  4^3_5^6_6^3          beta=  4.0 resname=SHM color=cyan"
puts "  5^12_6^8             beta=  5.0 resname=SHL color=blue"
puts "  5^12_6^1             beta=  6.0 resname=T13 color=gray"
puts "  5^12_6^3             beta=  7.0 resname=T15 color=yellow"
puts "  5^12_6^5             beta=  8.0 resname=T17 color=gray"
puts "  5^12_6^6             beta=  9.0 resname=T18 color=gray"
puts "  4^1_5^10_6^2         beta= 10.0 resname=A13 color=gray"
puts "  4^1_5^10_6^3         beta= 11.0 resname=A14 color=gray"
puts "  4^1_5^10_6^4         beta= 12.0 resname=A15 color=gray"
puts "  4^2_5^8_6^4          beta= 13.0 resname=A16 color=gray"
puts "  half_5^12            beta= 21.0 resname=HSM color=magenta"
puts "  half_5^12_6^2        beta= 22.0 resname=HLR color=purple"
puts "  half_5^12_6^4        beta= 23.0 resname=HLR color=pink"
puts "  half_4^3_5^6_6^3     beta= 24.0 resname=HSH color=gray"
puts "  half_5^12_6^8        beta= 25.0 resname=HSH color=gray"
puts "  half_5^12_6^1        beta= 26.0 resname=HT1 color=gray"
puts "  half_5^12_6^3        beta= 27.0 resname=HT1 color=gray"
puts "  half_5^12_6^5        beta= 28.0 resname=HT1 color=gray"
puts "  half_5^12_6^6        beta= 29.0 resname=HT1 color=gray"
puts "  half_4^1_5^10_6^2    beta= 30.0 resname=HA1 color=gray"
puts "  half_4^1_5^10_6^3    beta= 31.0 resname=HA1 color=gray"
puts "  half_4^1_5^10_6^4    beta= 32.0 resname=HA1 color=gray"
puts "  half_4^2_5^8_6^4     beta= 33.0 resname=HA1 color=gray"
puts "  partial_5^12         beta= 45.0 resname=P12 color=magenta"
puts "  partial_5^12_6^2     beta= 46.0 resname=P14 color=purple"
puts "  partial_5^12_6^4     beta= 47.0 resname=P16 color=pink"
puts "  incipient_cage       beta= 41.0 resname=INC color=tan"
puts "  open_cage            beta= 42.0 resname=OPN color=silver"
puts "  distorted_cage       beta= 43.0 resname=DST color=gray"
puts "  partial              beta= 44.0 resname=PAR color=white"
puts "  other                beta= 50.0 resname=OTH color=gray"
